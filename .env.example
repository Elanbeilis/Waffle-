# Copy to .env and fill in values.  Never commit .env to git.

# Anthropic (Step 6 — AI drafting)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio (Step 7 — SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# SendGrid or SMTP (Step 7 — Email)
# Option A: SendGrid
SENDGRID_API_KEY=SG....
EMAIL_FROM=you@yourdomain.com

# Option B: SMTP (set SMTP_HOST instead of SENDGRID_API_KEY)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password-here
# EMAIL_FROM=you@gmail.com

# NYC Open Data app token (optional — raises rate limit from ~100 to 1000 req/hr)
# Register free at https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=



# Quiet hours for SMS (24h format, local time)
SMS_QUIET_HOUR_START=21
SMS_QUIET_HOUR_END=8

# Your timezone (used for quiet-hours when lead location unknown)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LOCAL_TIMEZONE=America/New_York
